<?php
require __DIR__.'/auth.php';require_map_access(false);
require __DIR__.'/config.hhvm';require_once __DIR__.'/access_policy.php';require_once __DIR__.'/lib/region_messages.php';
header('Content-Type: text/html; charset=utf-8');header('Cache-Control: no-store');header('Referrer-Policy: same-origin');
function map_message_escape($text){return htmlspecialchars((string)$text,ENT_QUOTES,'UTF-8');}
try {
    if($_SERVER['REQUEST_METHOD']!=='POST'){http_response_code(405);throw new RuntimeException('Abra as mensagens a partir da seleção do Mapa.');}
    if(!isset($_POST['csrf'])||!is_string($_POST['csrf'])||!hash_equals(map_access_csrf(),$_POST['csrf'])){http_response_code(403);throw new RuntimeException('Sessão expirada. Atualize o Mapa.');}
    if(!permissao('perm_mensagem')||!permissao('perm_clientes')||!map_client_records_available()){http_response_code(403);throw new RuntimeException('Sem permissão para preparar mensagens aos clientes.');}
    $channel=isset($_POST['channel'])&&is_string($_POST['channel'])?$_POST['channel']:'';
    $labels=array('wapp'=>'WhatsApp','email'=>'E-mail','sms'=>'SMS');if(!isset($labels[$channel]))throw new RuntimeException('Canal inválido.');
    $channels=map_message_channels();if(!$channels[$channel])throw new RuntimeException('Este canal está desativado ou não foi configurado no MK-AUTH.');
    if(!isset($_POST['selection'])||!is_string($_POST['selection']))throw new RuntimeException('Seleção inválida.');
    $recipients=map_message_recipients(map_message_selection($_POST['selection']));
} catch(Exception $e){if(http_response_code()<400)http_response_code(422);echo '<!doctype html><meta charset="utf-8"><title>Mensagens do Mapa</title><p role="alert">'.map_message_escape($e->getMessage()).'</p>';exit;}
?>
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Preparar <?php echo map_message_escape($labels[$channel]); ?> — MK-AUTH</title>
<style>html,body{height:100%;margin:0;font:14px Arial,sans-serif;background:#f3f7fb;color:#183142}body{display:flex;flex-direction:column}header{padding:12px 18px;border-bottom:1px solid #d6e1eb;background:white}h1{font-size:18px;margin:0 0 5px}p{margin:5px 0;line-height:1.4}iframe{width:100%;flex:1;border:0;min-height:300px}#native-status{font-size:12px;color:#526980}button{margin-top:6px;padding:8px 12px}</style></head><body>
<header><h1>Preparar <?php echo map_message_escape($labels[$channel]); ?> para os clientes selecionados</h1><p>Confira os destinatários e escreva a mensagem na tela nativa. O envio só acontece quando você confirmar nela.</p><p id="native-status" role="status">Abrindo o compositor do MK-AUTH… Logins adicionais usam o cadastro principal; destinos repetidos são agrupados.</p></header>
<iframe name="map-native-composer" id="map-native-composer" title="Compositor nativo de mensagens do MK-AUTH"></iframe>
<form method="post" action="/admin/send_cliente.hhvm" target="map-native-composer" id="native-selection" accept-charset="UTF-8">
<?php foreach($recipients as $login){ ?><input type="hidden" name="login[]" value="<?php echo map_message_escape($login); ?>"><?php } ?>
<input type="hidden" name="check2All" value="0"><noscript><button type="submit">Abrir compositor nativo</button></noscript></form>
<script>
(function(){var frame=document.getElementById('map-native-composer'),status=document.getElementById('native-status'),channel=<?php echo json_encode($channel); ?>;
frame.addEventListener('load',function(){try{var w=frame.contentWindow;if(!/\/send_cliente\.(hhvm|php)$/.test(w.location.pathname))return;
if(typeof w.tipo_send_change==='function'){w.tipo_send_change(channel);status.textContent='Compositor nativo aberto. Confira o canal e os destinatários antes de enviar.';}
else status.textContent='Confira o canal disponível e os destinatários no compositor nativo. Se solicitado, entre novamente no MK-AUTH.';
}catch(e){status.textContent='Confira o canal e os destinatários na tela nativa do MK-AUTH.';}});
document.getElementById('native-selection').submit();})();
</script></body></html>
