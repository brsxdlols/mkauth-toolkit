  var clientMarkerMode=localStorage.getItem('mkauthMapClientMarkerMode')||'point';if(clientMarkerMode!=='house')clientMarkerMode='point';
  function setClientMarkerMode(mode,shouldRebuild){if(mode!=='house')mode='point';clientMarkerMode=mode;try{localStorage.setItem('mkauthMapClientMarkerMode',mode);}catch(e){}var points=document.getElementById('marker-mode-point'),houses=document.getElementById('marker-mode-house');points.classList.toggle('active',mode==='point');houses.classList.toggle('active',mode==='house');points.setAttribute('aria-pressed',mode==='point'?'true':'false');houses.setAttribute('aria-pressed',mode==='house'?'true':'false');if(shouldRebuild)rebuildMarkers();}
