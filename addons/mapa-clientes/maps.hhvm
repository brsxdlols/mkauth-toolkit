  document.getElementById('demo-run').addEventListener('click',function(){var option=document.getElementById('demo-alert').value,count=Number(document.getElementById('mass-threshold').value)||20;if(option==='siren'){startSiren(true);toast('Demonstração da sirene. Use o alerta crítico ou desmarque Sirene para parar.','down');setTimeout(stopSiren,6000);}if(option==='mass')criticalAlert(count,false);if(option==='online')toast('CLIENTE DEMONSTRAÇÃO voltou online','up');if(option==='offline')toast('CLIENTE DEMONSTRAÇÃO ficou offline','down');if(option==='both')criticalAlert(count,true);});

  function resetMobileViewport(){if(!window.matchMedia('(max-width:760px)').matches)return;var active=document.activeElement;if(active&&/^(INPUT|TEXTAREA|SELECT)$/.test(active.tagName))return;window.scrollTo(0,0);map.invalidateSize({pan:false});}
  document.addEventListener('focusout',function(){setTimeout(resetMobileViewport,250);});
  window.addEventListener('pageshow',resetMobileViewport);
  if(window.visualViewport)window.visualViewport.addEventListener('resize',function(){setTimeout(resetMobileViewport,100);});
  resetMobileViewport();
  function closeMobileClients(){
    document.getElementById('sidebar').classList.remove('open');document.body.classList.remove('mobile-sidebar-open');
    var button=document.getElementById('mobile-toggle');button.textContent='Buscar cliente';button.setAttribute('aria-label','Abrir clientes');button.setAttribute('aria-expanded','false');
    if(document.activeElement&&document.activeElement.blur)document.activeElement.blur();
  }
  document.getElementById('mobile-filters').addEventListener('click',function(){setFiltersOpen(true);});
  document.querySelectorAll('[data-filter-tab]').forEach(function(button){var names={general:'Geral',logins:'Logins',cto:'CTOs'};var label=document.createElement('span');label.className='mobile-tab-label';label.textContent=names[button.dataset.filterTab]||'';button.appendChild(label);});
  map.on('popupopen',function(event){if(!window.matchMedia('(max-width:760px)').matches)return;closeMobileClients();var card=event.popup.getElement();card.classList.add('mobile-client-card');document.body.appendChild(card);});
  window.addEventListener('resize',function(){var narrow=window.matchMedia('(max-width:760px)').matches;document.querySelectorAll('.mobile-client-card').forEach(function(card){if(!narrow&&!document.body.classList.contains('monitor-client')){card.classList.remove('mobile-client-card');map.getPane('popupPane').appendChild(card);}});map.invalidateSize(false);});

  document.getElementById('mobile-toggle').addEventListener('click',function(){var sidebar=document.getElementById('sidebar'),open=!sidebar.classList.contains('open');sidebar.classList.toggle('open',open);document.body.classList.toggle('mobile-sidebar-open',open);this.textContent=open?'Ver mapa':'Buscar cliente';this.setAttribute('aria-label',open?'Fechar clientes':'Abrir clientes');setTimeout(function(){map.invalidateSize(true);},230);});
  load(true);checkNasHealth();nasHealthTimer=setInterval(checkNasHealth,120000);
})();
</script>
</body>
</html>

