  /* Mobile: navigation, filters and client details */
@media(max-width:760px){
 html,body,#app{height:100dvh;max-width:100%;overflow:hidden}
 #app,#app.sidebar-collapsed{grid-template-columns:minmax(0,1fr)}
 #sidebar{inset:0 0 64px 0!important;width:100%!important;height:calc(100dvh - 64px)!important;max-height:calc(100dvh - 64px);border:0;opacity:1!important;pointer-events:auto!important}
 #sidebar .header{padding:12px}.header-title{flex-wrap:wrap}.header h1{font-size:18px}
 .header .back-mkauth{min-height:36px;display:flex;align-items:center}
 #sidebar .tools{padding:10px 12px;flex-shrink:0}#search,input[type=search],select{font-size:16px!important;min-height:44px}
 #client-list{overflow-y:auto;overscroll-behavior:contain;min-height:0;-webkit-overflow-scrolling:touch}.client{min-height:64px;padding:12px}.client-name{overflow-wrap:anywhere}.client-meta{flex-wrap:wrap}
 .btn,.counter,.filter-choice button,.filter-check,.filter-option{min-height:44px;touch-action:manipulation}.counter{padding:8px}
 #mobile-toggle,.mobile-sidebar-open #mobile-toggle{position:fixed!important;left:12px!important;right:auto!important;top:auto!important;bottom:max(10px,env(safe-area-inset-bottom))!important;width:calc(50% - 18px)!important;height:46px!important;font-size:15px!important;font-weight:700;z-index:3800!important;background:#1769aa!important;color:#fff!important;border:0!important}
 #mobile-filters{display:block;position:fixed;right:12px;bottom:max(10px,env(safe-area-inset-bottom));height:46px;width:calc(50% - 18px);z-index:3800;background:#fff;color:#17212b;font-weight:700;font-size:15px;box-shadow:0 2px 12px #0003}
 #mobile-nav-bg{display:block;position:fixed;inset:auto 0 0;height:66px;background:var(--panel);z-index:3700;border-top:1px solid var(--line)}
 .mobile-map-fullscreen #mobile-filters,.mobile-map-fullscreen #mobile-nav-bg{display:none}
 #filters-panel{left:8px!important;right:8px!important;top:8px!important;bottom:8px!important;width:auto!important;max-width:none!important;border-radius:12px!important;padding:14px!important;padding-top:70px!important;z-index:6000!important;max-height:calc(100dvh - 16px)}
 #filters-backdrop{inset:0!important;z-index:5900!important}.filters-subnav{left:14px!important;right:68px!important;top:12px!important;display:flex!important;gap:6px}.filters-subnav button{flex:1;width:auto!important;min-height:44px;border-radius:6px!important;font-size:14px!important}.filters-close{min-width:44px;min-height:44px}.filters-scroll{overscroll-behavior:contain}.filter-select-row{flex-wrap:wrap}.filter-choice-row{flex-wrap:wrap}
 body>.mobile-client-card{position:fixed!important;left:8px!important;right:8px!important;top:72px!important;bottom:76px!important;transform:none!important;margin:0!important;width:auto!important;max-width:none!important;z-index:4500!important;overflow-y:auto;overflow-x:hidden;background:#fff;border-radius:14px;box-shadow:0 8px 36px #0006;overscroll-behavior:contain}
 body>.mobile-client-card .leaflet-popup-content-wrapper{width:100%!important;box-sizing:border-box;box-shadow:none;height:auto!important}
 body>.mobile-client-card .leaflet-popup-content{width:auto!important;margin:18px 14px!important;height:auto!important;padding-top:26px}
 body>.mobile-client-card .popup,body>.mobile-client-card .cto-popup{min-width:0!important;max-width:100%!important;width:100%!important;height:auto!important;box-sizing:border-box}
 .popup-grid{grid-template-columns:minmax(85px,auto) minmax(0,1fr)!important;overflow-wrap:anywhere}.popup h3{overflow-wrap:anywhere}.leaflet-popup-close-button{min-width:44px;min-height:44px;font-size:28px!important;line-height:42px!important;background:#fff!important;border-radius:8px}
 body>.mobile-client-card .leaflet-popup-tip-container{display:none}
 body>.mobile-client-card .client-cto-route{position:relative!important;inset:auto!important;width:auto!important;max-width:100%;margin:12px!important;transform:none!important;box-sizing:border-box}
 .traffic-mini-title{flex-wrap:wrap}.traffic-monitor-btn{min-height:40px!important;font-size:12px!important}.traffic-mini{height:auto;min-height:160px}
 .monitor-client> .leaflet-popup .leaflet-popup-content{width:auto!important;margin:48px 12px 12px!important;padding:0!important}.monitor-client> .leaflet-popup .popup{min-width:0!important;width:100%!important;padding:0!important}.monitor-client> .leaflet-popup .popup-grid{padding:12px!important}.monitor-client> .leaflet-popup .traffic-mini{padding:12px!important}
 #coordinate-modal{padding:0}.coordinate-card{height:100dvh}.coordinate-search input{min-width:0}.coordinate-head{padding-left:12px}.coordinate-footer{padding:8px 12px}.guide-card{height:100dvh}
 .leaflet-bottom.leaflet-left{bottom:80px!important}.demo-bar{bottom:80px!important}.leaflet-top{top:4px}.fullscreen-toggle{width:44px;height:44px}
}
@media(min-width:761px){#mobile-filters,#mobile-nav-bg{display:none}}


@media(min-width:761px){.mobile-tab-label{display:none}}
@media(max-width:760px){.mobile-tab-label{display:inline;margin-left:5px}}
@media(max-width:760px){#filters-panel .filters-panel-header{height:0;padding:0;border:0}#filters-panel .filters-panel-header strong{display:none}#filters-close{position:absolute;right:14px;top:12px}}
@media(max-width:760px){
#filters-panel #filters-close{right:14px!important;top:12px!important;transform:none!important;margin:0!important}
#filters-panel .filters-subnav{right:72px!important}
.monitor-client> .leaflet-popup .popup{align-items:stretch!important}
.monitor-client> .leaflet-popup .popup h3,.monitor-client> .leaflet-popup .popup-grid{width:100%!important;box-sizing:border-box}
body>.mobile-client-card .leaflet-popup-close-button{position:fixed!important;top:76px!important;right:12px!important;z-index:5;display:block!important;width:44px;height:44px;margin:0!important;color:#1769aa!important}
.monitor-client> .mobile-client-card .leaflet-popup-close-button{position:fixed!important;margin:0!important;top:8px!important;right:8px!important}
}

@media(max-width:760px){
#filters-panel .filters-subnav{left:14px!important;right:82px!important;top:14px!important;gap:6px!important}
#filters-panel .filters-subnav button{min-width:0!important;flex:1 1 0!important;padding:6px!important}
#filters-panel #filters-close{position:absolute!important;left:auto!important;right:14px!important;top:14px!important;width:44px!important;height:44px!important;margin:0!important;transform:none!important;z-index:2}
}
#coordinate-modal{z-index:14000}.coordinate-gps{padding:8px 12px}#coordinate-gps-status{font-size:13px;line-height:1.4;margin-top:6px}#coordinate-gps:disabled{opacity:.6}
@media(max-width:760px){.coordinate-card{overflow-y:auto!important;display:block!important}.coordinate-body{height:350px!important;min-height:350px!important;grid-template-rows:90px 260px!important}#coordinate-map{min-height:260px!important}.coordinate-footer{position:relative}.coord-actions{display:flex}.coord-actions button{flex:1;min-height:44px}.coordinate-gps .btn{width:100%;min-height:44px}.coordinate-head{padding-right:90px}.coordinate-top-cancel{right:8px}.coord-grid input{font-size:16px}}

.coordinate-layer-tabs{display:flex;border-radius:5px;overflow:hidden;background:white;box-shadow:0 1px 6px #0004}.coordinate-layer-tabs button{border:0;border-right:1px solid #ddd;padding:9px 13px;background:#fff;color:#222;cursor:pointer;font-size:13px}.coordinate-layer-tabs button.active{background:#eee;font-weight:bold}
@media(max-width:760px){
.demo-bar{display:none!important}
#coordinate-modal .coordinate-card{display:flex!important;flex-direction:column!important;height:100dvh!important;max-height:100dvh!important;overflow:hidden!important}
#coordinate-modal .coordinate-head{padding:8px 80px 4px 10px!important;flex-shrink:0}#coordinate-title{font-size:17px!important;margin:0!important}#coordinate-client{font-size:12px!important;margin:3px 0!important}
#coordinate-modal .registered-address{margin:3px 10px!important;padding:5px 7px!important;font-size:11px!important;flex-shrink:0}#coordinate-modal .registered-address strong{display:none}.registered-address-actions{display:none!important}#registered-address-text{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
#coordinate-modal .coordinate-search{padding:4px 10px!important;gap:5px!important;flex-wrap:nowrap!important;flex-shrink:0}#coordinate-modal .coordinate-search input{width:0;flex:1;padding:6px!important;min-height:36px!important}#coordinate-modal .coordinate-search button{min-height:36px!important;padding:6px!important}
#coordinate-modal .coordinate-gps{padding:3px 10px!important;flex-shrink:0}#coordinate-gps{min-height:38px!important;padding:6px!important;font-size:13px!important}#coordinate-gps-status{font-size:11px!important;margin-top:3px!important;line-height:1.2!important}
#coordinate-modal .coordinate-tip{display:none!important}
#coordinate-modal .coordinate-body{position:relative!important;display:block!important;flex:1 1 auto!important;height:auto!important;min-height:130px!important;overflow:hidden!important}
#coordinate-map{height:100%!important;min-height:130px!important}.coordinate-suggestions{position:absolute;top:48px;left:8px;right:8px;z-index:1000;max-height:40%;border:0!important;border-radius:7px;box-shadow:0 2px 8px #0003}.coordinate-suggestions:has(>.empty){display:none}
#coordinate-modal .coordinate-footer{padding:5px 10px!important;flex-shrink:0}.coord-grid{gap:6px!important}.coord-grid label{font-size:11px!important}.coord-grid input{padding:4px!important;margin-top:2px!important;height:30px!important;min-height:30px!important;font-size:14px!important}
#coordinate-modal .coord-options{font-size:10px!important;padding:4px!important;margin-top:4px!important;min-height:0!important}.coord-error{font-size:10px!important;line-height:1.1!important;min-height:0!important;margin-top:3px!important}.coord-actions{margin-top:4px!important;gap:5px!important}.coord-actions button{font-size:12px!important;padding:5px!important;min-height:36px!important}
#coordinate-center{display:none!important}#coordinate-save{width:100%}.coordinate-top-cancel{top:7px!important;min-height:32px!important;font-size:12px!important;padding:5px!important}
}

body.monitor-client .popup h3,body.monitor-client .coordinate-edit-btn,body.monitor-client .client-cto-route{display:none!important}
body.monitor-client .popup-grid [data-info="Distância"]{display:none!important}
body.monitor-client>.leaflet-popup .popup{display:flex!important;flex-direction:column!important;gap:8px!important;min-height:0!important;height:100%!important;max-width:1200px!important}
body.monitor-client>.leaflet-popup .popup-grid{flex:0 0 auto!important;padding:8px 12px!important;border-radius:10px!important;box-sizing:border-box}
body.monitor-client>.leaflet-popup .popup-grid b,body.monitor-client>.leaflet-popup .popup-grid span{padding:2px 0!important;font-size:13px!important}
body.monitor-client>.leaflet-popup .traffic-mini{flex:1!important;min-height:0!important;height:auto!important;display:flex!important;flex-direction:column!important;padding:12px!important;overflow:hidden!important}
body.monitor-client>.leaflet-popup .traffic-mini-chart{flex:1!important;height:0!important;min-height:90px!important;aspect-ratio:auto!important;width:100%!important}
body.monitor-client>.leaflet-popup .leaflet-popup-content{height:calc(100dvh - 24px)!important;width:calc(100% - 24px)!important;margin:12px!important;padding:0!important;overflow:hidden!important}
body.monitor-client>.leaflet-popup{height:100dvh!important;overflow:hidden!important}
body.monitor-client>.leaflet-popup .traffic-mini-title{padding:0 0 6px!important;margin:0 0 6px!important;font-size:13px!important;gap:6px}
body.monitor-client .monitor-client-search{margin-bottom:8px}.monitor-client .monitor-client-search input{padding:8px 34px 8px 10px!important;min-height:38px!important}
body.monitor-client>.leaflet-popup .traffic-mini-legend{font-size:12px!important;flex-wrap:wrap;gap:5px!important;margin-top:7px!important}
body.monitor-client>.leaflet-popup .traffic-mini-legend b{font-size:14px!important}
@media(max-width:760px){
body:not(.monitor-client)>.mobile-client-card .leaflet-popup-content{margin:8px 10px!important;padding-top:22px!important}
body:not(.monitor-client)>.mobile-client-card .popup h3{font-size:14px!important;margin:0 25px 6px 0!important;line-height:1.15}
body:not(.monitor-client)>.mobile-client-card .popup-grid{font-size:11px!important;line-height:1.15!important;gap:3px 6px!important;grid-template-columns:100px minmax(0,1fr)!important}
body:not(.monitor-client)>.mobile-client-card .coordinate-edit-btn{font-size:11px!important;padding:5px!important;margin:6px 0!important;min-height:30px!important}
body:not(.monitor-client)>.mobile-client-card .traffic-mini{min-height:0!important;height:auto!important;margin-top:4px!important;padding-top:4px!important}
body:not(.monitor-client)>.mobile-client-card .traffic-mini-chart{height:78px!important}
body:not(.monitor-client)>.mobile-client-card .traffic-mini-title{font-size:10px!important;margin:0 0 3px!important;gap:3px!important}
body:not(.monitor-client)>.mobile-client-card .traffic-monitor-btn{min-height:28px!important;padding:4px 6px!important;font-size:10px!important}
body:not(.monitor-client)>.mobile-client-card .traffic-mini-legend{font-size:10px!important}
body.monitor-client>.leaflet-popup .leaflet-popup-content-wrapper{height:100dvh!important;width:100%!important}
