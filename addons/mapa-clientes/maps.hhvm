body.monitor-client>.leaflet-popup .popup{padding:0!important;width:100%!important}
body.monitor-client>.leaflet-popup .popup-grid{padding-right:46px!important}
body.monitor-client>.leaflet-popup .traffic-mini-status{font-size:11px!important;padding:4px!important}
body.monitor-client>.leaflet-popup .traffic-monitor-btn{font-size:11px!important;min-height:34px!important;padding:6px!important}
}

/* Keep the page viewport stable on mobile Safari. */
