  var coordinateMap=null,coordinateMarker=null,coordinateSearchTimer=null;
  function coordinatePosition(lat,lon){lat=Number(lat);lon=Number(lon);if(!isFinite(lat)||!isFinite(lon)||lat < -90||lat > 90||lon < -180||lon > 180)return;document.getElementById('coordinate-lat').value=lat.toFixed(7);document.getElementById('coordinate-lon').value=lon.toFixed(7);if(coordinateMarker)coordinateMarker.setLatLng([lat,lon]);if(coordinateMap)coordinateMap.setView([lat,lon],18);}
  function initCoordinateMap(){var center=map.getCenter();if(!coordinateMap){var pinIcon=L.divIcon({className:'coordinate-map-pin',html:'<div class="coordinate-map-pin-shape" title="Localização selecionada"></div>',iconSize:[36,42],iconAnchor:[15,38]});var coordinateStreet=L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap contributors'});var coordinateSatellite=L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',{maxZoom:19,attribution:'Tiles &copy; Esri'});coordinateMap=L.map('coordinate-map',{layers:[coordinateStreet]}).setView([center.lat,center.lng],15);var coordinateLayers=L.control({position:'topleft'});coordinateLayers.onAdd=function(){var box=L.DomUtil.create('div','coordinate-layer-tabs');['Mapa','Satélite'].forEach(function(label,i){var b=document.createElement('button');b.type='button';b.textContent=label;b.className=i?'':'active';b.setAttribute('aria-pressed',i?'false':'true');b.onclick=function(){coordinateMap.removeLayer(i?coordinateStreet:coordinateSatellite);coordinateMap.addLayer(i?coordinateSatellite:coordinateStreet);box.querySelectorAll('button').forEach(function(other){other.classList.toggle('active',other===b);other.setAttribute('aria-pressed',other===b?'true':'false');});};box.appendChild(b);});L.DomEvent.disableClickPropagation(box);return box;};coordinateLayers.addTo(coordinateMap);coordinateMap.zoomControl.remove();L.control.zoom({position:'topleft'}).addTo(coordinateMap);coordinateMarker=L.marker([center.lat,center.lng],{draggable:true,icon:pinIcon,title:'Localização selecionada'}).addTo(coordinateMap);coordinateMarker.on('dragend',function(){var p=coordinateMarker.getLatLng();coordinatePosition(p.lat,p.lng);});coordinateMap.on('click',function(e){coordinatePosition(e.latlng.lat,e.latlng.lng);});}else{coordinateMap.setView([center.lat,center.lng],15);coordinateMarker.setLatLng([center.lat,center.lng]);}setTimeout(function(){coordinateMap.invalidateSize();},80);}
  function featureLabel(p){return [p.name,p.street,p.housenumber,p.district||p.locality||p.neighbourhood,p.city||p.county,p.state,p.postcode].filter(function(v,i,a){return v&&a.indexOf(v)===i;}).join(', ');}
  function selectCoordinateFeature(feature){var coordinates=feature.geometry&&feature.geometry.coordinates,p=feature.properties||{};if(!coordinates||coordinates.length<2)return;state.selectedAddress=p;coordinatePosition(coordinates[1],coordinates[0]);document.getElementById('coordinate-error').textContent='Localização selecionada. Ajuste o marcador se necessário.';}
  function searchCoordinates(){var input=document.getElementById('coordinate-search'),q=input.value.trim(),box=document.getElementById('coordinate-suggestions');if(q.length<3){box.innerHTML='<div class="empty">Digite pelo menos 3 caracteres.</div>';return;}box.innerHTML='<div class="empty">Pesquisando no addon nativo…</div>';fetch('../geocodificacao/geocode.php?action=photon&q='+encodeURIComponent(q),{credentials:'same-origin',cache:'no-store'}).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json();}).then(function(data){var features=(data.features||[]).filter(function(f){return String((f.properties||{}).countrycode||'').toUpperCase()==='BR';});box.innerHTML='';if(!features.length){box.innerHTML='<div class="empty">Nenhum endereço encontrado.</div>';return;}features.forEach(function(feature){var button=document.createElement('button');button.type='button';button.className='coordinate-suggestion';button.textContent=featureLabel(feature.properties||{});button.addEventListener('click',function(){selectCoordinateFeature(feature);});box.appendChild(button);});}).catch(function(e){box.innerHTML='<div class="empty">Busca indisponível: '+esc(e.message)+'</div>';});}
  function registeredAddress(c){return [c.address,c.address_number,c.address_complement,c.district,c.city,c.state,c.postal_code].filter(Boolean).join(', ');}
  function openCoordinateModal(c){gpsRequest++;document.getElementById('coordinate-gps').disabled=false;document.getElementById('coordinate-gps-status').textContent='';state.editingClient=c;state.selectedAddress=null;var address=registeredAddress(c),logged=!!c.uuid,correcting=!!c.has_coordinates,addressBox=document.querySelector('.registered-address'),addressTitle=addressBox.querySelector('strong');document.getElementById('coordinate-title').textContent=correcting?'Corrigir coordenadas':'Pesquisar e adicionar coordenadas';document.getElementById('coordinate-client').textContent=(c.name||c.login)+' — '+c.login+(c.is_additional?' (adicional)':'');addressTitle.textContent=logged?(correcting?'Endereço cadastrado — ajuste a coordenada atual':'Endereço cadastrado, mas coordenada não preenchida'):'Sessão administrativa encerrada';document.getElementById('registered-address-text').textContent=logged?(address||'Endereço não informado no cadastro.'):'Entre novamente no MK-AUTH para consultar o cadastro e salvar coordenadas.';var editLink=document.getElementById('coordinate-client-edit');editLink.href=logged?'../../'+(c.is_additional?'adicional_alt.hhvm':'cliente_alt.hhvm')+'?uuid='+encodeURIComponent(c.uuid):'../../login.php';editLink.textContent=logged?'Alterar diretamente no cadastro':'Entrar no MK-AUTH';document.getElementById('coordinate-google-maps').href=address?'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(address):'https://www.google.com/maps';document.getElementById('coordinate-lat').value=correcting?Number(c.lat).toFixed(7):'';document.getElementById('coordinate-lon').value=correcting?Number(c.lon).toFixed(7):'';document.getElementById('coordinate-search').value=address;document.getElementById('coordinate-fill-address').checked=false;document.getElementById('coordinate-suggestions').innerHTML='<div class="empty">'+(logged?(address?'O endereço cadastrado já foi colocado na pesquisa. Clique em Pesquisar.':'Digite pelo menos 3 caracteres para pesquisar.'):'Faça login no MK-AUTH e depois atualize esta página.')+'</div>';document.getElementById('coordinate-error').textContent=logged?(correcting?'A coordenada atual está carregada. Arraste o marcador, clique no mapa ou pesquise outro endereço.':'Você também pode digitar latitude e longitude manualmente.'):'É necessário estar logado para salvar alterações no cadastro.';document.getElementById('coordinate-save').disabled=!logged;document.getElementById('coordinate-modal').classList.add('show');initCoordinateMap();if(correcting)coordinatePosition(c.lat,c.lon);}
  var gpsRequest=0;
  function closeCoordinateModal(){gpsRequest++;document.getElementById('coordinate-gps').disabled=false;state.editingClient=null;document.getElementById('coordinate-modal').classList.remove('show');}
  document.getElementById('coordinate-gps').addEventListener('click',function(){
    var status=document.getElementById('coordinate-gps-status'),button=this,client=state.editingClient,request=++gpsRequest;
    if(!window.isSecureContext){status.textContent='Abra o sistema por HTTPS para permitir a localização.';return;}
    if(!navigator.geolocation){status.textContent='Este navegador não oferece localização.';return;}
    button.disabled=true;status.textContent='Obtendo localização. Permita o acesso quando o celular solicitar…';
    navigator.geolocation.getCurrentPosition(function(position){
      if(request!==gpsRequest||state.editingClient!==client)return;
      button.disabled=false;var coords=position.coords;
      coordinatePosition(coords.latitude,coords.longitude);state.selectedAddress=null;document.getElementById('coordinate-fill-address').checked=false;
      status.textContent='Localização obtida. Precisão estimada: '+Math.round(coords.accuracy)+' m. '+(coords.accuracy>50?'Sinal impreciso: aguarde em local aberto e tente novamente. ':'')+'Confira o marcador e toque em Confirmar e salvar.';
    },function(error){if(request!==gpsRequest)return;button.disabled=false;status.textContent=error.code===1?'Permissão negada. Autorize a localização nas configurações do navegador e tente novamente.':error.code===3?'Tempo esgotado. Vá a um local com melhor sinal e tente novamente.':'Localização indisponível. Confira o GPS do celular e tente novamente.';},{enableHighAccuracy:true,maximumAge:0,timeout:20000});
  });
  var coordinateTopCancel=document.createElement('button');coordinateTopCancel.id='coordinate-top-cancel';coordinateTopCancel.className='btn coordinate-top-cancel';coordinateTopCancel.type='button';coordinateTopCancel.textContent='Cancelar';coordinateTopCancel.setAttribute('aria-label','Cancelar e fechar');document.querySelector('.coordinate-head').appendChild(coordinateTopCancel);coordinateTopCancel.addEventListener('click',closeCoordinateModal);
  var fullscreenToggle=document.createElement('button');fullscreenToggle.id='fullscreen-toggle';fullscreenToggle.className='fullscreen-toggle';fullscreenToggle.type='button';fullscreenToggle.textContent='⛶';fullscreenToggle.setAttribute('aria-label','Alternar tela cheia');fullscreenToggle.title='Tela cheia';document.body.appendChild(fullscreenToggle);
  function fullscreenElement(){return document.fullscreenElement||document.webkitFullscreenElement;}
  function appFullscreen(){return !!fullscreenElement()||document.body.classList.contains('mobile-map-fullscreen');}
  function enterFullscreen(){var app=document.getElementById('app');state.sidebarBeforeFullscreen=app.classList.contains('sidebar-collapsed');app.classList.add('sidebar-collapsed');if(window.matchMedia('(max-width:760px)').matches){document.getElementById('sidebar').classList.remove('open');document.body.classList.remove('mobile-sidebar-open');document.body.classList.add('mobile-map-fullscreen');fullscreenToggle.title='Sair da tela cheia';setTimeout(function(){map.invalidateSize(true);},180);return;}var target=document.documentElement,request=target.requestFullscreen||target.webkitRequestFullscreen;if(request){var result=request.call(target);if(result&&result.catch)result.catch(function(){app.classList.toggle('sidebar-collapsed',state.sidebarBeforeFullscreen);});}fullscreenToggle.textContent='⛶';fullscreenToggle.title='Sair da tela cheia';setTimeout(function(){map.invalidateSize(true);},250);}
  function exitFullscreen(){if(document.body.classList.contains('mobile-map-fullscreen')){document.body.classList.remove('mobile-map-fullscreen');document.getElementById('app').classList.toggle('sidebar-collapsed',state.sidebarBeforeFullscreen);fullscreenToggle.title='Tela cheia';setTimeout(function(){map.invalidateSize(true);},180);return;}var exit=document.exitFullscreen||document.webkitExitFullscreen;if(exit)exit.call(document);}
  fullscreenToggle.addEventListener('click',function(){if(appFullscreen())exitFullscreen();else enterFullscreen();});
  document.addEventListener('fullscreenchange',function(){var active=!!fullscreenElement(),app=document.getElementById('app');fullscreenToggle.textContent='⛶';fullscreenToggle.title=active?'Sair da tela cheia':'Tela cheia';if(!active)app.classList.toggle('sidebar-collapsed',state.sidebarBeforeFullscreen);setTimeout(function(){map.invalidateSize();},250);});
  function ufFromProperties(p){if(p.statecode&&p.statecode.indexOf('-')!==-1)return p.statecode.split('-').pop().toUpperCase();var states={'Rio Grande do Norte':'RN','Goiás':'GO','São Paulo':'SP','Minas Gerais':'MG','Rio de Janeiro':'RJ','Paraná':'PR','Santa Catarina':'SC','Rio Grande do Sul':'RS','Bahia':'BA','Distrito Federal':'DF','Mato Grosso':'MT','Mato Grosso do Sul':'MS','Tocantins':'TO','Pará':'PA','Amazonas':'AM','Acre':'AC','Rondônia':'RO','Roraima':'RR','Amapá':'AP','Maranhão':'MA','Piauí':'PI','Ceará':'CE','Paraíba':'PB','Pernambuco':'PE','Alagoas':'AL','Sergipe':'SE','Espírito Santo':'ES'};return states[p.state]||'';}
  function saveCoordinates(){var c=state.editingClient;if(!c)return;var lat=document.getElementById('coordinate-lat').value.trim().replace(',','.'),lon=document.getElementById('coordinate-lon').value.trim().replace(',','.'),fill=document.getElementById('coordinate-fill-address').checked,p=state.selectedAddress||{};if(!lat||!lon||!isFinite(Number(lat))||!isFinite(Number(lon))||Math.abs(Number(lat))>90||Math.abs(Number(lon))>180){document.getElementById('coordinate-error').textContent='Informe latitude e longitude válidas.';return;}if(fill&&!state.selectedAddress){document.getElementById('coordinate-error').textContent='Para preencher o endereço, selecione primeiro um resultado da pesquisa.';return;}var message='Usar a coordenada '+lat+','+lon+' para '+(c.name||c.login)+'?';if(fill)message+=' O endereço de instalação também será preenchido com: '+featureLabel(p)+'.';else message+=' O endereço atual será mantido.';if(!window.confirm(message))return;document.getElementById('coordinate-error').textContent='Salvando…';var body=new URLSearchParams({csrf:coordinateCsrf,id:String(c.id),client_kind:c.client_kind||'primary',lat:lat,lon:lon,fill_address:fill?'1':'0',cep:p.postcode||'',endereco:p.street||p.name||'',numero:p.housenumber||'',bairro:p.district||p.locality||p.neighbourhood||'',cidade:p.city||p.county||'',estado:ufFromProperties(p),cidade_ibge:p.ibge||''});fetch('maps_clientes_coord_update.hhvm',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:body.toString()}).then(function(r){return r.json().then(function(data){if(!r.ok)throw new Error(data.error||'HTTP '+r.status);return data;});}).then(function(data){closeCoordinateModal();toast((data.address_updated?'Coordenadas e endereço salvos para ':'Coordenadas salvas para ')+(c.name||c.login),'up');load(true);}).catch(function(e){document.getElementById('coordinate-error').textContent=e.message;});}
  document.getElementById('client-list').addEventListener('click',function(e){var el=e.target.closest('.client');if(!el)return;var c=state.clients.find(function(x){return x.login===el.dataset.login;});if(!c)return;if(c.has_coordinates&&state.markers[c.login]){map.setView([c.lat,c.lon],17,{animate:!window.matchMedia('(max-width:760px)').matches});pulseClient(c);state.markers[c.login].openPopup();}else openCoordinateModal(c);});
  document.addEventListener('click',function(e){var button=e.target.closest('.coordinate-edit-btn');if(!button)return;e.preventDefault();e.stopPropagation();var c=state.clients.find(function(client){return client.login===button.dataset.coordinateLogin;});if(c){openCoordinateModal(c);document.getElementById('coordinate-title').textContent='Ajustar localização';}},true);
  document.getElementById('coordinate-center').addEventListener('click',function(){var center=map.getCenter();coordinatePosition(center.lat,center.lng);});document.getElementById('coordinate-cancel').addEventListener('click',closeCoordinateModal);document.getElementById('coordinate-save').addEventListener('click',saveCoordinates);document.getElementById('coordinate-search-button').addEventListener('click',searchCoordinates);document.getElementById('coordinate-search').addEventListener('input',function(){clearTimeout(coordinateSearchTimer);coordinateSearchTimer=setTimeout(searchCoordinates,500);});document.getElementById('coordinate-search').addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();searchCoordinates();}});document.getElementById('coordinate-lat').addEventListener('change',function(){coordinatePosition(this.value,document.getElementById('coordinate-lon').value);});document.getElementById('coordinate-lon').addEventListener('change',function(){coordinatePosition(document.getElementById('coordinate-lat').value,this.value);});
  var guideIndex=0,guideSlides=Array.prototype.slice.call(document.querySelectorAll('.guide-slide'));function showGuideSlide(index){guideIndex=Math.max(0,Math.min(guideSlides.length-1,index));guideSlides.forEach(function(slide,i){slide.classList.toggle('active',i===guideIndex);});document.getElementById('guide-progress').textContent=(guideIndex+1)+' de '+guideSlides.length;document.getElementById('guide-prev').disabled=guideIndex===0;document.getElementById('guide-next').textContent=guideIndex===guideSlides.length-1?'Concluir':'Próximo';}function openGuide(){document.getElementById('guide-modal').classList.add('show');showGuideSlide(0);}function closeGuide(){document.getElementById('guide-modal').classList.remove('show');}document.getElementById('guide-open').addEventListener('click',openGuide);document.getElementById('guide-close').addEventListener('click',closeGuide);document.getElementById('guide-prev').addEventListener('click',function(){showGuideSlide(guideIndex-1);});document.getElementById('guide-next').addEventListener('click',function(){if(guideIndex===guideSlides.length-1)closeGuide();else showGuideSlide(guideIndex+1);});document.getElementById('guide-modal').addEventListener('click',function(e){if(e.target===this)closeGuide();});
  document.addEventListener('keydown',function(e){if(e.key!=='Escape')return;closeGuide();closeCoordinateModal();closeCritical();map.closePopup();document.getElementById('toast-container').innerHTML='';stopSiren();});
  document.getElementById('sidebar-toggle').addEventListener('click',function(){var app=document.getElementById('app');app.classList.toggle('sidebar-collapsed');this.title=app.classList.contains('sidebar-collapsed')?'Mostrar painel de clientes':'Esconder painel de clientes';setTimeout(function(){map.invalidateSize();},230);});
