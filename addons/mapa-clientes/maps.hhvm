  function loadCtos(){if(ctosLoaded||ctosLoading)return;ensureCtos().then(function(items){ctos.clearLayers();items.forEach(function(c){var marker=L.marker([c.lat,c.lon],{icon:ctoIcon(c),title:c.name||'Caixa CTO'}).bindPopup(ctoPopup(c),{maxWidth:390,autoPan:!window.matchMedia('(max-width:760px)').matches,closeOnClick:!window.matchMedia('(max-width:760px)').matches});marker.on('popupopen',function(){focusCto(c,marker);});marker.on('popupclose',function(){if(ctoFocusMarker===marker)restoreCtoFocus();});marker.addTo(ctos);});ctosLoaded=true;if(!items.length)toast('O MAPA DE CTO está instalado, mas não há caixas com coordenadas.','down');});}
  function setCtoButton(enabled){var button=document.getElementById('cto-toggle');if(!button)return;button.classList.toggle('active',enabled);button.setAttribute('aria-pressed',enabled?'true':'false');button.title=enabled?'Ocultar caixas CTO do mapa':'Mostrar caixas CTO no mapa';}
  function saveCtoPreference(enabled){try{localStorage.setItem('mkauthMapCtoVisible',enabled?'1':'0');}catch(e){}}
  function applyCtoVisibility(enabled){if(enabled){ctos.addTo(map);loadCtos();}else{if(ctoFocusMarker)restoreCtoFocus();map.removeLayer(ctos);}setCtoButton(enabled);}
  document.getElementById('cto-toggle').addEventListener('click',function(){var enabled=!map.hasLayer(ctos);applyCtoVisibility(enabled);saveCtoPreference(enabled);});
  (function restoreCtoPreference(){var saved=null;try{saved=localStorage.getItem('mkauthMapCtoVisible');}catch(e){}applyCtoVisibility(saved==='1');})();
  function openCtoClient(row){if(!row)return;var login=row.getAttribute('data-client-login'),marker=login&&state.markers[login];if(!marker){toast('Este cliente não possui coordenadas para localização no mapa.','down');return;}activePopupLogin=login;map.panTo(marker.getLatLng(),{animate:true,duration:.35});setTimeout(function(){if(state.markers[login]===marker)marker.openPopup();},120);}
  document.getElementById('map').addEventListener('click',function(e){var row=e.target.closest&&e.target.closest('.cto-client');if(!row)return;e.preventDefault();e.stopPropagation();openCtoClient(row);});
  document.getElementById('map').addEventListener('keydown',function(e){var row=e.target.closest&&e.target.closest('.cto-client');if(!row||(e.key!=='Enter'&&e.key!==' '))return;e.preventDefault();e.stopPropagation();openCtoClient(row);});
  function enhanceClientCtoRoute(section){if(!section||section.querySelector('.client-cto-expand'))return;var title=section.querySelector('.client-cto-route-title'),button=document.createElement('button'),home=section.parentNode,backdrop=null;button.className='client-cto-expand';button.type='button';button.textContent='⛶';button.title='Ampliar mapa';button.setAttribute('aria-label','Ampliar mapa');title.appendChild(button);function resizeMini(){window.dispatchEvent(new Event('resize'));[40,180,420,900,1600].forEach(function(delay){setTimeout(function(){var holder=section.querySelector('.client-cto-map'),mini=holder&&holder._routeMap;if(!mini)return;mini.invalidateSize({pan:false});var bounds=L.latLngBounds([]);mini.eachLayer(function(layer){if(layer.getBounds){var b=layer.getBounds();if(b&&b.isValid&&b.isValid())bounds.extend(b);}else if(layer.getLatLng){var p=layer.getLatLng();if(p)bounds.extend(p);}});if(bounds.isValid())mini.fitBounds(bounds,{padding:[24,24],maxZoom:18});},delay);});}function collapse(remove){if(!backdrop)return;section.classList.remove('route-expanded');if(!remove&&home&&home.isConnected)home.appendChild(section);backdrop.remove();backdrop=null;button.textContent='⛶';button.title='Ampliar mapa';button.setAttribute('aria-label','Ampliar mapa');resizeMini();}function expand(){if(backdrop)return;backdrop=document.createElement('div');backdrop.className='client-cto-backdrop';document.body.appendChild(backdrop);backdrop.appendChild(section);button.textContent='↙';button.title='Diminuir mapa';button.setAttribute('aria-label','Diminuir mapa');backdrop.addEventListener('click',function(e){if(e.target===backdrop)collapse(false);});resizeMini();}function keyHandler(e){if(e.key==='Escape'&&backdrop)collapse(false);}function popupCloseHandler(){collapse(true);document.removeEventListener('keydown',keyHandler);map.off('popupclose',popupCloseHandler);}button.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();if(backdrop)collapse(false);else expand();});document.addEventListener('keydown',keyHandler);map.on('popupclose',popupCloseHandler);resizeMini();}
  function createMiniRouteOverlay(holder,mini,clientPoint,ctoPoint,section){var ns='http://www.w3.org/2000/svg',svg=document.createElementNS(ns,'svg'),fiber=document.createElementNS(ns,'polyline'),radio=document.createElementNS(ns,'line'),client=document.createElementNS(ns,'circle'),cto=document.createElementNS(ns,'circle'),road=null;svg.setAttribute('aria-hidden','true');svg.style.cssText='position:absolute;inset:0;width:100%;height:100%;z-index:900;pointer-events:none;overflow:hidden';fiber.setAttribute('fill','none');fiber.setAttribute('stroke','#1769aa');fiber.setAttribute('stroke-width','5');fiber.setAttribute('stroke-linejoin','round');fiber.setAttribute('stroke-linecap','round');radio.setAttribute('stroke','#ed8b00');radio.setAttribute('stroke-width','4');radio.setAttribute('stroke-dasharray','8 6');client.setAttribute('r','7');client.setAttribute('fill','#159447');client.setAttribute('stroke','#fff');client.setAttribute('stroke-width','3');cto.setAttribute('r','8');cto.setAttribute('fill','#8a5a24');cto.setAttribute('stroke','#fff');cto.setAttribute('stroke-width','3');svg.appendChild(fiber);svg.appendChild(radio);svg.appendChild(client);svg.appendChild(cto);holder.appendChild(svg);function redraw(){if(!holder.isConnected)return;var a=mini.latLngToContainerPoint(clientPoint),b=mini.latLngToContainerPoint(ctoPoint),points=(road&&road.length?road:[]).map(function(p){var q=mini.latLngToContainerPoint(p);return q.x+','+q.y;}).join(' ');svg.setAttribute('viewBox','0 0 '+Math.max(1,holder.clientWidth)+' '+Math.max(1,holder.clientHeight));fiber.setAttribute('points',points);radio.setAttribute('x1',a.x);radio.setAttribute('y1',a.y);radio.setAttribute('x2',b.x);radio.setAttribute('y2',b.y);client.setAttribute('cx',a.x);client.setAttribute('cy',a.y);cto.setAttribute('cx',b.x);cto.setAttribute('cy',b.y);radio.style.display='';fiber.style.display=road&&road.length?'':'none';}mini.on('move zoom moveend zoomend resize',redraw);[0,80,250,600,1200].forEach(function(delay){setTimeout(redraw,delay);});return{setRoad:function(points){road=points;redraw();},redraw:redraw};}
  new MutationObserver(function(records){records.forEach(function(record){Array.prototype.forEach.call(record.addedNodes,function(node){if(node.nodeType!==1)return;if(node.matches&&node.matches('.client-cto-route'))enhanceClientCtoRoute(node);Array.prototype.forEach.call(node.querySelectorAll?node.querySelectorAll('.client-cto-route'):[],enhanceClientCtoRoute);});});}).observe(document.getElementById('map'),{childList:true,subtree:true});
  setInterval(function(){document.querySelectorAll('.client-cto-route').forEach(function(section){var holder=section.querySelector('.client-cto-map'),mini=holder&&holder._routeMap;if(!mini)return;var routeLayers=Object.keys(mini._layers||{}).map(function(id){return mini._layers[id];}),points=routeLayers.filter(function(layer){return layer&&layer.options&&layer.options.pane==='routePane'&&layer.getLatLng;}).map(function(layer){return layer.getLatLng();});if(points.length>=2&&!holder._domRouteOverlay)holder._domRouteOverlay=createMiniRouteOverlay(holder,mini,points[0],points[1],section);if(holder._domRouteOverlay){var road=routeLayers.filter(function(layer){return layer&&layer.options&&layer.options.pane==='routePane'&&layer.getLatLngs&&layer.getLatLngs().length>2;})[0];if(road)holder._domRouteOverlay.setRoad(road.getLatLngs());else holder._domRouteOverlay.redraw();}});},250);
  setInterval(function(){document.querySelectorAll('.client-cto-route-distance').forEach(function(label){if(label.textContent.indexOf('Calculando rota')<0){delete label.dataset.routeWaiting;return;}if(!label.dataset.routeWaiting)label.dataset.routeWaiting=String(Date.now());if(Date.now()-Number(label.dataset.routeWaiting)>8000)label.textContent=label.textContent.replace('Calculando rota…','Prévia da rota pelas ruas');});},500);
  var savedBaseLayer=localStorage.getItem('mkauth_map_base_layer')||localStorage.getItem('mapsBaseLayer');
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function value(v){return v==null||v===''?'—':esc(v);}
  function duration(sec){if(sec==null)return '—';sec=Math.max(0,Number(sec)||0);var d=Math.floor(sec/86400),h=Math.floor(sec%86400/3600),m=Math.floor(sec%3600/60);return (d?d+'d ':'')+(h?h+'h ':'')+m+'min';}
  function dateText(v){if(!v)return '—';var d=new Date(String(v).replace(' ','T'));return isNaN(d.getTime())?value(v):d.toLocaleString('pt-BR');}
  function distance(a,b){var R=6371,p=Math.PI/180,dLat=(b.lat-a.lat)*p,dLon=(b.lon-a.lon)*p,s1=Math.sin(dLat/2),s2=Math.sin(dLon/2),x=s1*s1+Math.cos(a.lat*p)*Math.cos(b.lat*p)*s2*s2;return 2*R*Math.atan2(Math.sqrt(x),Math.sqrt(1-x));}
  function nearestProvider(c){if(!c.has_coordinates||!state.providers.length)return null;var best=null;state.providers.forEach(function(p){var km=distance(c,p);if(!best||km<best.km)best={name:p.name,km:km};});return best;}
  function popup(c){var p=nearestProvider(c),rows=[['Login',c.login],['Endereço',registeredAddress(c)||'Não informado'],['Status',c.status==='online'?'Online':'Offline'],['Contrato',c.blocked?'🔒 Bloqueado':'Ativo'],['Tempo online',c.status==='online'?duration(c.online_seconds):null],['Conectado em',c.connected_at],['Última desconexão',c.last_disconnected_at],['IP atual',c.framed_ip],['MAC sessão',c.calling_station_id],['NAS',c.nas_ip],['Porta NAS',c.nas_port],['Sessões abertas',c.session_count||null],['Plano',c.plan],['Interface',c.interface],['Ramal',c.branch],['Porta OLT',c.olt_port],['CTO',c.cto],['Porta CTO',c.splitter_port],['ONU/ONT',c.onu_ont],['Distância',p?(p.km<1?Math.round(p.km*1000)+' m':p.km.toFixed(2)+' km')+' de '+p.name:null]];
    var html='<div class="popup"><h3>'+value(c.name||c.login)+'</h3><div class="popup-grid">';rows.forEach(function(r){if(r[1]!=null&&r[1]!==''){var shown=(r[0].indexOf(' em')>0||r[0].indexOf('desconexão')>0?dateText(r[1]):value(r[1]));if(r[0]==='Última desconexão')shown+=' <a class="client-log-btn" href="../../relatorios_u.hhvm?login='+encodeURIComponent(c.login)+'" target="_blank" rel="noopener">LOG</a>';html+='<b data-info="'+esc(r[0])+'">'+esc(r[0])+'</b><span data-info="'+esc(r[0])+'" class="'+(r[0]==='Status'?'status-'+c.status:(r[0]==='Contrato'&&c.blocked?'status-offline':''))+'">'+shown+'</span>';}});html+='</div><button class="coordinate-edit-btn" type="button" data-coordinate-login="'+esc(c.login)+'">📍 AJUSTAR LOCALIZAÇÃO</button>';if(c.status==='online')html+='<div class="traffic-mini" data-traffic-login="'+esc(c.login)+'"><div class="traffic-mini-title"><span>Tráfego em tempo real</span><span class="traffic-mini-status">Conectando…</span></div><svg class="traffic-mini-chart" viewBox="0 0 400 92" preserveAspectRatio="none"><line class="traffic-mini-grid" x1="34" y1="8" x2="400" y2="8"/><line class="traffic-mini-grid" x1="34" y1="46" x2="400" y2="46"/><line class="traffic-mini-grid" x1="34" y1="84" x2="400" y2="84"/><text class="traffic-mini-scale traffic-scale-max" x="2" y="11">1 Mbps</text><text class="traffic-mini-scale traffic-scale-mid" x="2" y="49">0.5</text><text class="traffic-mini-scale" x="20" y="87">0</text><polyline class="traffic-mini-rx" points=""></polyline><polyline class="traffic-mini-tx" points=""></polyline></svg><div class="traffic-mini-legend">↓ Download <b class="traffic-rx">0</b> Mbps &nbsp; ↑ Upload <b class="traffic-tx">0</b> Mbps</div></div>';else html+='<div class="traffic-unavailable">Tráfego em tempo real disponível quando o cliente estiver online.</div>';return html+'</div>';
  }
  function markerLock(blocked){return blocked?'<span class="client-map-marker-lock" title="Contrato bloqueado"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M4 7V5a4 4 0 0 1 8 0v2h1v8H3V7h1zm2 0h4V5a2 2 0 1 0-4 0v2z"/></svg></span>':'';}
  function icon(client){var status=client.status==='offline'?'offline':'online';if(clientMarkerMode==='point')return L.divIcon({html:'<div class="pin '+status+(client.blocked?' locked':'')+'"></div>',className:'',iconSize:[22,22],iconAnchor:[11,11]});var lock=markerLock(client.blocked);if(client.is_additional){return L.divIcon({html:'<div class="client-map-marker additional status-'+status+'"><svg viewBox="0 0 38 36" aria-hidden="true"><circle cx="19" cy="9" r="5" fill="currentColor" stroke="#fff" stroke-width="1.5"/><circle cx="8" cy="12" r="4" fill="currentColor" stroke="#fff" stroke-width="1.5"/><circle cx="30" cy="12" r="4" fill="currentColor" stroke="#fff" stroke-width="1.5"/><path d="M11 31v-7c0-5 3.5-8 8-8s8 3 8 8v7zM1 30v-6c0-4 2.5-7 7-7 2 0 3.4.6 4.6 1.7-2.3 2-3.6 4.8-3.6 8.3v3zm28 0v-3c0-3.5-1.3-6.3-3.6-8.3A6.5 6.5 0 0 1 30 17c4.5 0 7 3 7 7v6z" fill="currentColor" stroke="#fff" stroke-width="1.2"/></svg><span class="client-map-marker-status"></span>'+lock+'</div>',className:'',iconSize:[38,38],iconAnchor:[19,34],popupAnchor:[0,-31]});}return L.divIcon({html:'<div class="client-map-marker house status-'+status+'"><svg viewBox="0 0 38 40" aria-hidden="true"><path d="M3 18 19 4l16 14v18H3z" fill="currentColor" stroke="#17212b" stroke-width="2" stroke-linejoin="round"/><path d="M15 36V24h8v12M8 18V9h6v4" fill="none" stroke="#fff" stroke-width="2.2" stroke-linejoin="round"/></svg>'+lock+'</div>',className:'',iconSize:[36.1,38],iconAnchor:[18.05,35.15],popupAnchor:[0,-32.3]});}
  var trafficTimer=null,trafficRequest=null,trafficLogin=null,activePopupLogin=null,rebuildingMarkers=false,monitorMode=false,monitorPopupElement=null,trafficSeries={rx:[],tx:[],times:[]};
  function stopTraffic(reset){if(trafficTimer){clearTimeout(trafficTimer);trafficTimer=null;}if(trafficRequest){trafficRequest.abort();trafficRequest=null;}if(reset!==false)trafficSeries={rx:[],tx:[],times:[]};}
  function trafficPoints(values,max){return values.map(function(v,i){var x=values.length<2?400:(34+i*366/(values.length-1)),y=84-(Number(v||0)/max*76);return x.toFixed(1)+','+y.toFixed(1);}).join(' ');}
  function trafficScale(v){if(v>=100)return Math.ceil(v).toFixed(0);if(v>=10)return (Math.ceil(v*2)/2).toFixed(1);return (Math.ceil(v*10)/10).toFixed(1);}
  function trafficDots(box,values,max,kind){var svg=box.querySelector('.traffic-mini-chart'),group=svg.querySelector('.traffic-mini-dots-'+kind);if(!group){group=document.createElementNS('http://www.w3.org/2000/svg','g');group.setAttribute('class','traffic-mini-dots-'+kind);svg.appendChild(group);}while(group.firstChild)group.removeChild(group.firstChild);var n=Math.max(values.length-1,1);values.forEach(function(v,i){var dot=document.createElementNS('http://www.w3.org/2000/svg','circle'),tip=document.createElementNS('http://www.w3.org/2000/svg','title');dot.setAttribute('cx',34+(366*i/n));dot.setAttribute('cy',84-(Math.min(v,max)/max*76));dot.setAttribute('r',i===values.length-1?'3.2':'2');dot.setAttribute('class','traffic-mini-dot-'+kind+(i===values.length-1?' traffic-mini-dot-last':''));tip.textContent='Coleta '+trafficSeries.times[i]+' · Download '+trafficSeries.rx[i].toFixed(2)+' Mbps · Upload '+trafficSeries.tx[i].toFixed(2)+' Mbps';dot.appendChild(tip);group.appendChild(dot);});}
  function renderTraffic(box,data){trafficSeries.rx.push(Number(data.rx_mbps)||0);trafficSeries.tx.push(Number(data.tx_mbps)||0);trafficSeries.times.push(new Date().toLocaleTimeString('pt-BR'));if(trafficSeries.rx.length>24){trafficSeries.rx.shift();trafficSeries.tx.shift();trafficSeries.times.shift();}var observed=Math.max.apply(null,trafficSeries.rx.concat(trafficSeries.tx)),max=Math.max(1,Number(trafficScale(observed)));box.querySelector('.traffic-mini-rx').setAttribute('points',trafficPoints(trafficSeries.rx,max));box.querySelector('.traffic-mini-tx').setAttribute('points',trafficPoints(trafficSeries.tx,max));trafficDots(box,trafficSeries.rx,max,'rx');trafficDots(box,trafficSeries.tx,max,'tx');box.querySelector('.traffic-scale-max').textContent=trafficScale(max)+' Mbps';box.querySelector('.traffic-scale-mid').textContent=trafficScale(max/2);box.querySelector('.traffic-rx').textContent=(Number(data.rx_mbps)||0).toFixed(2);box.querySelector('.traffic-tx').textContent=(Number(data.tx_mbps)||0).toFixed(2);box.querySelector('.traffic-mini-status').textContent=(data.ping_ms!=null?data.ping_ms+' ms · ':'')+(data.uptime||'online');}
  function setMonitorMode(on){monitorMode=!!on;if(monitorMode){monitorPopupElement=document.querySelector('#map .leaflet-popup')||document.querySelector('body > .leaflet-popup');if(monitorPopupElement&&monitorPopupElement.parentNode!==document.body)document.body.appendChild(monitorPopupElement);document.body.classList.add('monitor-client');setTimeout(setupMonitorSearch,0);}else{if(document.body.classList.contains('monitor-entry')){location.href='/admin/';return;}document.querySelectorAll('.monitor-client-search').forEach(function(search){search.remove();});document.body.classList.remove('monitor-client');if(monitorPopupElement&&monitorPopupElement.isConnected){var narrow=window.matchMedia('(max-width:760px)').matches;var pane=narrow?document.body:map.getPane('popupPane');monitorPopupElement.classList.toggle('mobile-client-card',narrow);if(pane)pane.appendChild(monitorPopupElement);}monitorPopupElement=null;}var btn=document.querySelector('.traffic-monitor-btn');if(btn)btn.textContent=monitorMode?'SAIR DO MONITORAMENTO':'AMPLIAR';if(monitorMode){if(refreshTimer)clearTimeout(refreshTimer);if(countdownTimer)clearInterval(countdownTimer);document.getElementById('countdown').textContent='Monitoramento dedicado';setTimeout(function(){map.invalidateSize();},100);}else scheduleRefresh();}
  function switchMonitoredClient(c){var content=document.querySelector('.monitor-client .leaflet-popup-content');if(!content||!c)return;stopTraffic();trafficLogin=null;activePopupLogin=c.login;content.innerHTML=popup(c);setupMonitorButton();setupMonitorSearch();startTraffic(c.login);}
  function setupMonitorSearch(){if(!monitorMode)return;var traffic=document.querySelector('.monitor-client .traffic-mini');if(!traffic||traffic.querySelector('.monitor-client-search'))return;var wrap=document.createElement('div'),input=document.createElement('input'),results=document.createElement('div');wrap.className='monitor-client-search';input.type='search';input.placeholder='Buscar outro cliente online por nome ou login';input.setAttribute('aria-label','Buscar outro cliente para monitorar');results.className='monitor-search-results';wrap.appendChild(input);wrap.appendChild(results);traffic.insertBefore(wrap,traffic.firstChild);input.addEventListener('input',function(){var q=this.value.trim().toLowerCase();results.innerHTML='';if(q.length<2)return;var found=state.clients.filter(function(c){return c.status==='online'&&((c.name||'').toLowerCase().indexOf(q)!==-1||(c.login||'').toLowerCase().indexOf(q)!==-1);}).slice(0,10);if(!found.length){results.innerHTML='<div class="monitor-search-empty">Nenhum cliente online encontrado.</div>';return;}found.forEach(function(c){var button=document.createElement('button');button.type='button';button.className='monitor-search-result';button.innerHTML='<strong>'+esc(c.name||c.login)+'</strong><small>'+esc(c.login)+' · Online</small>';button.addEventListener('click',function(){switchMonitoredClient(c);});results.appendChild(button);});});input.addEventListener('keydown',function(e){if(e.key==='Escape'){results.innerHTML='';this.value='';e.stopPropagation();}});}
  function setupMonitorButton(){var title=document.querySelector('.traffic-mini-title'),chart=document.querySelector('.traffic-mini-chart');if(chart)chart.setAttribute('preserveAspectRatio','xMidYMid meet');if(!title||title.querySelector('.traffic-monitor-btn'))return;var btn=document.createElement('button');btn.type='button';btn.className='traffic-monitor-btn';btn.textContent=monitorMode?'SAIR DO MONITORAMENTO':'AMPLIAR';btn.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();setMonitorMode(!monitorMode);});title.appendChild(btn);}
  function pollTraffic(login){var box=document.querySelector('.traffic-mini[data-traffic-login="'+CSS.escape(login)+'"]');if(!box)return stopTraffic();trafficRequest=new AbortController();fetch('traffic_api.hhvm?login='+encodeURIComponent(login),{credentials:'same-origin',cache:'no-store',signal:trafficRequest.signal}).then(function(r){return r.json().then(function(data){if(!r.ok||!data.ok)throw new Error(data.error||'HTTP '+r.status);return data;});}).then(function(data){renderTraffic(box,data);}).catch(function(e){if(e.name!=='AbortError'){var status=box.querySelector('.traffic-mini-status');if(status)status.textContent=e.message;}}).finally(function(){trafficRequest=null;if(document.querySelector('.traffic-mini[data-traffic-login="'+CSS.escape(login)+'"]'))trafficTimer=setTimeout(function(){pollTraffic(login);},3000);});}
  function startTraffic(login){stopTraffic(trafficLogin!==login);trafficLogin=login;setTimeout(function(){pollTraffic(login);},80);}
  function setupClientCtoRoute(c){if(!c||!c.cto||!c.has_coordinates)return;var leafletPopup=(document.querySelector('#map .leaflet-popup')||document.querySelector('body > .mobile-client-card')),popupBox=leafletPopup&&leafletPopup.querySelector('.popup');if(!leafletPopup||!popupBox||leafletPopup.querySelector('.client-cto-route'))return;var section=document.createElement('div');section.className='client-cto-route';section.innerHTML='<div class="client-cto-route-title"><strong>'+value(c.name||c.login)+'</strong><span>'+value(c.cto)+(c.splitter_port?' · Porta '+value(c.splitter_port):'')+'</span><em class="client-cto-route-distance">Calculando distâncias…</em></div><div class="client-cto-map"><div class="client-cto-empty">Localizando CTO…</div></div>';leafletPopup.appendChild(section);var popupRect=leafletPopup.getBoundingClientRect(),mapRect=document.getElementById('map').getBoundingClientRect();if(popupRect.right+364>mapRect.right)section.classList.add('route-left');ensureCtos().then(function(items){if(!section.isConnected)return;var wanted=String(c.cto||'').trim().toLowerCase(),cto=items.find(function(item){return String(item.name||'').trim().toLowerCase()===wanted||String(item.id)===wanted;});var holder=section.querySelector('.client-cto-map');if(!cto){section.querySelector('.client-cto-route-distance').textContent='Distância indisponível';holder.innerHTML='<div class="client-cto-empty">CTO vinculada não localizada no Mapa de CTO.</div>';return;}var directDistance=distance({lat:c.lat,lon:c.lon},{lat:cto.lat,lon:cto.lon}),directText=directDistance<1?Math.round(directDistance*1000)+' m':directDistance.toFixed(2)+' km';section.querySelector('.client-cto-route-title span').innerHTML=value(cto.name||c.cto)+(c.splitter_port?' · Porta '+value(c.splitter_port):'');section.querySelector('.client-cto-route-distance').textContent='🟠 Linha reta: '+directText+' · 🔵 Calculando rota…';holder.innerHTML='';var mini=L.map(holder,{zoomControl:false,attributionControl:false,dragging:false,scrollWheelZoom:false,doubleClickZoom:false,boxZoom:false,keyboard:false,tap:false,preferCanvas:true});holder._routeMap=mini;createBaseLayer(map.hasLayer(satellite)?'satellite':'map').addTo(mini);mini.createPane('routePane');mini.getPane('routePane').style.zIndex='650';mini.getPane('routePane').style.pointerEvents='none';var clientPoint=[c.lat,c.lon],ctoPoint=[cto.lat,cto.lon];L.circleMarker(clientPoint,{pane:'routePane',radius:8,color:'#fff',weight:3,fillColor:c.status==='online'?'#159447':'#d13c3c',fillOpacity:1}).bindTooltip(c.name||c.login).addTo(mini);L.circleMarker(ctoPoint,{pane:'routePane',radius:9,color:'#fff',weight:3,fillColor:'#8a5a24',fillOpacity:1}).bindTooltip(cto.name||'CTO').addTo(mini);L.polyline([clientPoint,ctoPoint],{pane:'routePane',color:'#ed8b00',weight:4,dashArray:'7 6',opacity:1}).bindTooltip('Linha reta / enlace PTP').addTo(mini);mini.fitBounds([clientPoint,ctoPoint],{padding:[24,24],maxZoom:18});var routeUrl='route_api.hhvm?coords='+encodeURIComponent(c.lon+','+c.lat+';'+cto.lon+','+cto.lat);fetch(routeUrl,{credentials:'same-origin',cache:'no-store'}).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json();}).then(function(data){if(!section.isConnected)return;if(data.code!=='Ok'||!data.routes||!data.routes[0]||!data.routes[0].geometry)throw new Error(data.code||'Sem rota');var route=data.routes[0],roadPoints=route.geometry.coordinates.map(function(point){return [point[1],point[0]];});L.polyline(roadPoints,{pane:'routePane',color:'#1769aa',weight:5,opacity:1,lineJoin:'round'}).bindTooltip('Rota aproximada pelas ruas').addTo(mini);var snapped=(data.waypoints||[]).map(function(point){return [point.location[1],point.location[0]];});if(snapped.length===2){L.polyline([clientPoint,snapped[0]],{pane:'routePane',color:'#1769aa',weight:3,dashArray:'3 5',opacity:.9}).addTo(mini);L.polyline([snapped[1],ctoPoint],{pane:'routePane',color:'#1769aa',weight:3,dashArray:'3 5',opacity:.9}).addTo(mini);}mini.fitBounds(L.latLngBounds(roadPoints.concat([clientPoint,ctoPoint])),{padding:[20,20],maxZoom:18});var km=Number(route.distance||0)/1000,roadText=km<1?Math.round(km*1000)+' m':km.toFixed(2)+' km';section.querySelector('.client-cto-route-distance').textContent='🟠 Linha reta: '+directText+' · 🔵 Rota pelas ruas: '+roadText;}).catch(function(){if(!section.isConnected)return;section.querySelector('.client-cto-route-distance').textContent='🟠 Linha reta: '+directText+' · 🔵 Rota pelas ruas indisponível';});setTimeout(function(){mini.invalidateSize();},100);});}
  function rebuildMarkers(){var reopen=activePopupLogin;rebuildingMarkers=true;stopTraffic(false);cluster.clearLayers();plain.clearLayers();state.markers={};filtered().forEach(function(c){if(!c.has_coordinates)return;var m=L.marker([c.lat,c.lon],{icon:icon(c),title:(c.name||c.login)+(c.blocked?' — bloqueado':'')}).bindPopup(popup(c),{maxWidth:460,autoPan:!window.matchMedia('(max-width:760px)').matches,closeOnClick:!window.matchMedia('(max-width:760px)').matches});m.on('popupopen',function(){activePopupLogin=c.login;[40,160,360].forEach(function(delay){setTimeout(function(){if(activePopupLogin===c.login)setupClientCtoRoute(c);},delay);});if(c.status==='online'){startTraffic(c.login);setTimeout(setupMonitorButton,0);}});m.on('popupclose',function(){if(!rebuildingMarkers&&state.markers[c.login]===m){setMonitorMode(false);activePopupLogin=null;trafficLogin=null;stopTraffic();if(state.ctoFocusLogins)restoreCtoFocus();}});state.markers[c.login]=m;cluster.addLayer(m);plain.addLayer(m);});rebuildingMarkers=false;if(reopen&&state.markers[reopen])setTimeout(function(){state.markers[reopen].openPopup();},0);}
function filtered(){var q=state.query.toLowerCase();return state.clients.filter(function(c){if(state.ctoFocusLogins&&!state.ctoFocusLogins[c.login])return false;if(state.clientKind==='additional'&&!c.is_additional)return false;if(state.clientKind==='primary'&&c.is_additional)return false;if(state.filter==='online'&&c.status!=='online')return false;if(state.filter==='offline'&&c.status!=='offline')return false;if(state.filter==='unmapped'&&c.has_coordinates)return false;if(!q)return true;return [c.name,c.login,c.framed_ip,c.calling_station_id,c.registered_ip,c.registered_mac].some(function(v){return v&&String(v).toLowerCase().indexOf(q)!==-1;});});}
  function renderList(){var list=document.getElementById('client-list'),items=filtered();if(!items.length){list.innerHTML='<div class="empty">Nenhum cliente encontrado.</div>';return;}list.innerHTML=items.map(function(c){var when=c.status==='online'?'Online há '+duration(c.online_seconds):(c.last_disconnected_at?'Desconectou '+dateText(c.last_disconnected_at):'Sem histórico de desconexão');return '<div class="client" data-login="'+esc(c.login)+'"><div class="client-name"><span class="dot '+c.status+'"></span> '+value(c.name||c.login)+'</div><div class="client-meta"><span>'+value(c.login)+'</span><span>'+esc(when)+'</span>'+(!c.has_coordinates?'<span class="badge">sem coordenadas</span>':'')+'</div></div>';}).join('');}
  function render(){rebuildMarkers();renderList();}
  function counts(s){document.getElementById('count-total').textContent=s.total;document.getElementById('count-online').textContent=s.online;document.getElementById('count-offline').textContent=s.offline;document.getElementById('count-unmapped').textContent=s.unmapped;}
  function toast(text,type){var box=document.getElementById('toast-container'),el=document.createElement('div');el.className='toast '+type;el.textContent=text;box.insertBefore(el,box.firstChild);while(box.children.length>3)box.removeChild(box.lastChild);setTimeout(function(){if(el.parentNode)el.parentNode.removeChild(el);},6500);}
  var nasHealthSignature=null,nasHealthTimer=null;
  function checkNasHealth(){fetch('nas_health.hhvm',{credentials:'same-origin',cache:'no-store'}).then(function(r){return r.json();}).then(function(data){if(!data.ok)throw new Error(data.error||'Falha na verificação das APIs.');var bad=data.offline||[],signature=bad.map(function(n){return n.ip+'|'+n.message;}).sort().join(';');if(bad.length&&signature!==nasHealthSignature){var names=bad.slice(0,5).map(function(n){return n.name+' ('+n.ip+')';}).join(', ');toast('API MikroTik indisponível: '+names+'. O tráfego em tempo real pode ficar indisponível.','down');}else if(!bad.length&&nasHealthSignature)toast('Todas as APIs MikroTik dos ramais/NAS estão conectadas.','up');nasHealthSignature=signature;}).catch(function(e){if(nasHealthSignature===null)toast('Não foi possível verificar as APIs MikroTik: '+e.message,'down');nasHealthSignature='health-error';});}
  var audioContext=null,sirenTimer=null,sirenOscillator=null;
  function prepareAudio(){if(!audioContext){var AudioCtor=window.AudioContext||window.webkitAudioContext;if(AudioCtor)audioContext=new AudioCtor();}if(audioContext&&audioContext.state==='suspended')audioContext.resume();}
  function stopSiren(){if(sirenTimer){clearInterval(sirenTimer);sirenTimer=null;}if(sirenOscillator){try{sirenOscillator.stop();}catch(e){}sirenOscillator=null;}}
  function startSiren(force){if(!force&&!document.getElementById('alert-sound').checked)return;prepareAudio();if(!audioContext)return;var begin=function(){stopSiren();var gain=audioContext.createGain();gain.gain.setValueAtTime(.0001,audioContext.currentTime);gain.gain.exponentialRampToValueAtTime(.22,audioContext.currentTime+.04);gain.connect(audioContext.destination);sirenOscillator=audioContext.createOscillator();sirenOscillator.type='sawtooth';sirenOscillator.frequency.setValueAtTime(620,audioContext.currentTime);sirenOscillator.connect(gain);sirenOscillator.start(audioContext.currentTime);var high=false;sirenTimer=setInterval(function(){high=!high;if(sirenOscillator)sirenOscillator.frequency.setValueAtTime(high?980:620,audioContext.currentTime);},420);};var resumed=audioContext.resume();if(resumed&&resumed.then)resumed.then(begin).catch(function(){toast('O celular bloqueou o áudio. Retire o modo silencioso e toque novamente em Executar.','down');});else begin();}
  function criticalAlert(total,forceSound){document.getElementById('critical-count').textContent=total;document.getElementById('critical-alert').classList.add('show');if(forceSound===true)startSiren(true);else if(forceSound!==false)startSiren(false);}
  function closeCritical(){document.getElementById('critical-alert').classList.remove('show');stopSiren();}
  function changes(clients){if(state.initial)return;var confirmed=[];clients.forEach(function(c){var old=state.previous[c.login];if(!old){state.previous[c.login]=c.status;return;}if(old===c.status){delete state.pending[c.login];return;}var p=state.pending[c.login];if(!p||p.status!==c.status){state.pending[c.login]={status:c.status,count:1};return;}p.count++;if(p.count>=2){confirmed.push(c);state.previous[c.login]=c.status;delete state.pending[c.login];}});if(!document.getElementById('notifications').checked||!confirmed.length)return;var up=confirmed.filter(function(c){return c.status==='online';}),down=confirmed.filter(function(c){return c.status==='offline';}),threshold=Number(document.getElementById('mass-threshold').value);if(up.length)toast(up.length===1?(up[0].name||up[0].login)+' voltou online':up.length+' clientes voltaram online','up');if(threshold>0&&down.length>=threshold)criticalAlert(down.length);else if(down.length)toast(down.length===1?(down[0].name||down[0].login)+' ficou offline':down.length+' clientes ficaram offline','down');}
  var refreshTimer=null,countdownTimer=null,nextRefreshAt=0,monitorShortcutOpened=false;
  function openMonitorShortcut(){if(monitorShortcutOpened||new URLSearchParams(location.search).get('monitor')!=='1')return;var c=state.clients.find(function(client){return client.status==='online';});if(!c){document.body.classList.remove('monitor-entry');toast('Nenhum cliente online disponível para iniciar o monitoramento.','down');return;}monitorShortcutOpened=true;activePopupLogin=c.login;var shell=document.createElement('div'),wrapper=document.createElement('div'),content=document.createElement('div');shell.className='leaflet-popup leaflet-zoom-animated';wrapper.className='leaflet-popup-content-wrapper';content.className='leaflet-popup-content';content.innerHTML=popup(c);wrapper.appendChild(content);shell.appendChild(wrapper);document.body.appendChild(shell);monitorPopupElement=shell;setMonitorMode(true);setupMonitorButton();setupMonitorSearch();startTraffic(c.login);}
  function refreshSeconds(){return Number(document.getElementById('refresh-interval').value)||60;}
  function updateCountdown(){var remaining=Math.max(0,Math.ceil((nextRefreshAt-Date.now())/1000));document.getElementById('countdown').textContent='Próxima atualização: '+remaining+'s';}
  function scheduleRefresh(){if(refreshTimer)clearTimeout(refreshTimer);if(countdownTimer)clearInterval(countdownTimer);if(monitorMode){document.getElementById('countdown').textContent='Monitoramento dedicado';return;}nextRefreshAt=Date.now()+refreshSeconds()*1000;updateCountdown();countdownTimer=setInterval(updateCountdown,1000);refreshTimer=setTimeout(function(){if(countdownTimer)clearInterval(countdownTimer);document.getElementById('countdown').textContent='Atualizando…';load(false);},refreshSeconds()*1000);}
  function siteIcon(type){var symbol=type==='provider'?'🏢':'📡';return L.divIcon({className:'map-site-icon',html:'<div class="map-site-pin '+type+'">'+symbol+'</div>',iconSize:[40,40],iconAnchor:[20,20],popupAnchor:[0,-21]});}
  function addressText(item){return [item.address,item.number,item.district,item.city,item.state].filter(Boolean).join(', ');}
  function renderSites(){providers.clearLayers();branches.clearLayers();state.providerMarkers=[];state.branchMarkers=[];state.providers.forEach(function(p){var address=addressText(p),html='<b>🏢 '+value(p.name||'Provedor')+'</b>'+(address?'<br>'+value(address):''),marker=L.marker([p.lat,p.lon],{icon:siteIcon('provider'),title:p.name||'Provedor'}).bindPopup(html).addTo(providers);state.providerMarkers.push(marker);});state.branches.forEach(function(b){var address=addressText(b),html='<b>📡 '+value(b.name||b.description||'Concentrador PPPoE')+'</b>'+(b.nas?'<br>NAS: '+value(b.nas):'')+(address?'<br>'+value(address):''),marker=L.marker([b.lat,b.lon],{icon:siteIcon('branch'),title:b.name||'Concentrador PPPoE'}).bindPopup(html).addTo(branches);state.branchMarkers.push(marker);});}
  function pulseSites(items,color){siteRadar.clearLayers();if(siteRadarTimer)clearTimeout(siteRadarTimer);items.forEach(function(item){L.marker([item.lat,item.lon],{interactive:false,zIndexOffset:1300,icon:L.divIcon({className:'site-radar',html:'<span class="site-radar-ring" style="--site-radar-color:'+color+'"></span>',iconSize:[180,180],iconAnchor:[90,90]})}).addTo(siteRadar);});siteRadarTimer=setTimeout(function(){siteRadar.clearLayers();},5100);}
  function focusSites(type){map.closePopup();var isProvider=type==='provider',items=isProvider?state.providers:state.branches,markers=isProvider?state.providerMarkers:state.branchMarkers;if(!items.length){toast(isProvider?'Empresa sem coordenadas cadastradas.':'Nenhum NAS com coordenadas cadastrado.','down');return;}applySiteLayer(type,true);var bounds=L.latLngBounds(items.map(function(item){return [item.lat,item.lon];}));if(items.length===1){map.setView([items[0].lat,items[0].lon],17);}else map.fitBounds(bounds.pad(.18),{maxZoom:15});pulseSites(items,isProvider?'#1769aa':'#d57918');}
  function pulseClient(c){if(!c||!c.has_coordinates)return;if(radarMarker)map.removeLayer(radarMarker);if(radarTimer)clearTimeout(radarTimer);radarMarker=L.marker([c.lat,c.lon],{interactive:false,zIndexOffset:1200,icon:L.divIcon({className:'client-radar',html:'<span class="client-radar-ring"></span>',iconSize:[100,100],iconAnchor:[50,50]})}).addTo(map);radarTimer=setTimeout(function(){if(radarMarker)map.removeLayer(radarMarker);radarMarker=null;},2050);}
  function load(manual){if(state.loading)return;if(document.hidden&&!manual){scheduleRefresh();return;}state.loading=true;fetch('maps_clientes_api.hhvm',{credentials:'same-origin',cache:'no-store'}).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json();}).then(function(data){if(!data.ok)throw new Error(data.error||'Resposta inválida');changes(data.clients);state.clients=data.clients;state.providers=data.providers||[];state.branches=data.branches||[];if(state.initial){state.previous={};state.clients.forEach(function(c){state.previous[c.login]=c.status;});}counts(data.summary);renderSites();if(state.initial){var preferred=savedBaseLayer||(data.options&&data.options.initial_layer==='satelite'?'satelite':'mapa');if(preferred==='satellite')preferred='satelite';if(preferred==='map')preferred='mapa';if(preferred==='satelite'){map.removeLayer(street);satellite.addTo(map);}else{map.removeLayer(satellite);street.addTo(map);}var switchBox=mapTypeSwitch.getContainer();if(switchBox&&switchBox.setActive)switchBox.setActive(preferred);}render();document.getElementById('updated').textContent='Atualizado '+new Date().toLocaleTimeString('pt-BR');if(state.initial)initialFit();state.initial=false;openMonitorShortcut();}).catch(function(e){document.getElementById('client-list').innerHTML='<div class="empty">Falha ao carregar clientes.<br><small>'+esc(e.message)+'</small></div>';toast('Falha ao atualizar: '+e.message,'down');}).finally(function(){state.loading=false;scheduleRefresh();});}
  function fit(){var group=activeLayer.getLayers();if(group.length){var bounds=activeLayer.getBounds();if(bounds.isValid())map.fitBounds(bounds.pad(.08),{maxZoom:16});}}
  function geoDistanceKm(a,b){var rad=Math.PI/180,dLat=(b.lat-a.lat)*rad,dLon=(b.lng-a.lng)*rad,lat1=a.lat*rad,lat2=b.lat*rad,s=Math.sin(dLat/2),t=Math.sin(dLon/2),h=s*s+Math.cos(lat1)*Math.cos(lat2)*t*t;return 6371*2*Math.atan2(Math.sqrt(h),Math.sqrt(1-h));}
  function median(values){values=values.slice().sort(function(a,b){return a-b;});var n=values.length,m=Math.floor(n/2);return n%2?values[m]:(values[m-1]+values[m])/2;}
  function initialFit(){var points=[];activeLayer.eachLayer(function(layer){if(layer&&typeof layer.getLatLng==='function'){var p=layer.getLatLng();if(p&&isFinite(p.lat)&&isFinite(p.lng))points.push(p);}});if(points.length<3){fit();return;}var center={lat:median(points.map(function(p){return p.lat;})),lng:median(points.map(function(p){return p.lng;}))};var distances=points.map(function(p){return geoDistanceKm(center,p);}).sort(function(a,b){return a-b;});var q75=distances[Math.floor((distances.length-1)*.75)]||0;var cutoff=Math.max(25,Math.min(150,Math.max(q75*4,25)));var core=points.filter(function(p){return geoDistanceKm(center,p)<=cutoff;});if(core.length<Math.max(2,Math.ceil(points.length*.6)))core=points;var bounds=L.latLngBounds(core);if(bounds.isValid())map.fitBounds(bounds.pad(.08),{maxZoom:16});else fit();}
