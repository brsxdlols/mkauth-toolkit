<?php
require __DIR__ . '/auth.php';
require_map_access(false);
$map_coord_csrf = map_access_csrf();
require __DIR__ . '/config.hhvm';
$map_provider = 'openstreet';
$map_google_key = '';
$map_options_query = mysqli_query($link, "SELECT nome,valor FROM sis_opcao WHERE nome IN ('server_maps','key_googlemaps')");
if ($map_options_query) {
    while ($map_option = mysqli_fetch_assoc($map_options_query)) {
        if ($map_option['nome'] === 'server_maps') $map_provider = strtolower(trim($map_option['valor']));
        if ($map_option['nome'] === 'key_googlemaps') $map_google_key = trim($map_option['valor']);
    }
}
$map_use_google = ($map_provider === 'google' || $map_provider === 'googlemaps') && $map_google_key !== '';
?>
