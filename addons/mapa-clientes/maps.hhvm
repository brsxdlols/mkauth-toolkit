  function ctoPopup(c){var groups={};(c.clients||[]).forEach(function(client){var port=String(client.port||'Sem porta');if(!groups[port])groups[port]=[];groups[port].push(client);});var ports=Object.keys(groups).sort(function(a,b){return (parseInt(a,10)||9999)-(parseInt(b,10)||9999)||a.localeCompare(b);}),html='<div class="cto-popup"><h3>📦 '+value(c.name||'Caixa CTO')+'</h3><div class="cto-summary">'+(c.type?'Tipo: '+value(c.type)+' · ':'')+(c.capacity?'Capacidade: '+value(c.capacity)+' · ':'')+'Clientes: '+(c.clients||[]).length+(c.address?'<br>'+value(c.address):'')+'</div><a class="cto-edit-link" href="../caixas/?_route=editar&amp;id='+encodeURIComponent(c.id)+'" target="_blank" rel="noopener">✏ EDITAR CTO</a><div class="cto-port-list">';if(!ports.length)html+='<div class="client-cto-empty">Nenhum cliente vinculado a esta CTO.</div>';ports.forEach(function(port){html+='<div class="cto-port"><strong>Porta '+value(port)+'</strong>';groups[port].forEach(function(client){var current=state.clients.find(function(item){return item.login===client.login;}),status=current?current.status:'';html+='<div class="cto-client" role="button" tabindex="0" data-client-login="'+value(client.login)+'" title="Localizar e abrir este cliente"><i class="cto-client-dot '+status+'"></i><span>'+value(client.name||client.login)+' <small>('+value(client.login)+')</small></span></div>';});html+='</div>';});return html+'</div></div>';}
  function ensureCtos(){if(ctoPromise)return ctoPromise;ctosLoading=true;ctoPromise=fetch('cto_api.hhvm',{credentials:'same-origin',cache:'no-store'}).then(function(r){return r.json();}).then(function(data){if(!data.ok)throw new Error(data.error||'Falha ao consultar CTOs.');if(!data.installed){map.removeLayer(ctos);setCtoButton(false);toast('MAPA DE CTO não está instalado. Entre em contato com Bruno Fontes.','down');return [];}ctoData=data.ctos||[];return ctoData;}).catch(function(e){ctoPromise=null;map.removeLayer(ctos);setCtoButton(false);toast('Não foi possível carregar as CTOs: '+e.message,'down');return [];}).finally(function(){ctosLoading=false;});return ctoPromise;}
  function restoreCtoFocus(){if(!state.ctoFocusLogins)return;var focused=state.ctoFocusLogins;setTimeout(function(){if(activePopupLogin&&focused[activePopupLogin])return;if(state.ctoFocusLogins!==focused)return;state.ctoFocusLogins=null;ctoFocusMarker=null;render();},80);}
